msgid "Office Map – OpenStreetMap Map Without API Key"
msgstr "Office Map – карта OpenStreetMap без API-ключа"

msgid "https://wordpress.org/plugins/office-map/"
msgstr ""

msgid "Interactive vector maps with OpenStreetMap and MapLibre GL — no API keys, no ads, no tracking. Shortcode, widget and a visual style editor. Style presets inspired by Google Maps and Yandex Maps."
msgstr "Интерактивные векторные карты на OpenStreetMap и MapLibre GL — без API-ключей, рекламы и отслеживания. Шорткод, виджет и визуальный редактор стиля. Пресеты оформления в стиле Google Maps и Яндекс.Карт."

msgid "Prodevel"
msgstr ""

msgid "https://wpdev.com.ru"
msgstr ""

msgid "Office Map"
msgstr "Office Map"

msgid "Marker image"
msgstr "Изображение метки"

msgid "Use image"
msgstr "Использовать"

msgid "Search address…"
msgstr "Поиск адреса…"

msgid "Find"
msgstr "Найти"

msgid "Searching…"
msgstr "Поиск…"

msgid "Nothing found"
msgstr "Ничего не найдено"

msgid "Search error"
msgstr "Ошибка поиска"

msgid "Copied!"
msgstr "Скопировано!"

msgid "Our office"
msgstr "Наш офис"

msgid "Add the office address"
msgstr "Укажите адрес офиса"

msgid "Percent (%)"
msgstr "Проценты (%)"

msgid "Pixels (px)"
msgstr "Пиксели (px)"

msgid "Search by address"
msgstr "Поиск по адресу"

msgid "Type an address — the coordinates will be filled in automatically."
msgstr "Введите адрес — координаты заполнятся автоматически."

msgid "Latitude (lat)"
msgstr "Широта (lat)"

msgid "For example 53.900600."
msgstr "Например, 53.900600."

msgid "Longitude (lng)"
msgstr "Долгота (lng)"

msgid "For example 27.559000."
msgstr "Например, 27.559000."

msgid "Height, px"
msgstr "Высота, px"

msgid "Zoom"
msgstr "Приближение (zoom)"

msgid "1–20; for an office usually 15–18."
msgstr "1–20; для офиса обычно 15–18."

msgid "Width"
msgstr "Ширина"

msgid "Value"
msgstr "Значение"

msgid "For the “Custom” preset."
msgstr "Для пресета «Своя»."

msgid "Unit"
msgstr "Единица"

msgid "Zoom mode"
msgstr "Режим масштаба"

msgid "Marker title"
msgstr "Заголовок метки"

msgid "Address (HTML allowed)"
msgstr "Адрес (можно HTML)"

msgid "Allowed HTML tags: <br>, <strong>, <em>, <a href=\"…\">, <span style=\"…\"> and others. Line breaks are preserved."
msgstr "Разрешены теги: <br>, <strong>, <em>, <a href=\"…\">, <span style=\"…\"> и другие. Переносы строк сохраняются."

msgid "Custom marker"
msgstr "Своя метка"

msgid "PNG/SVG with the tip at the bottom. Used by default for all markers; each extra point can have its own icon."
msgstr "PNG/SVG, острие снизу. Используется по умолчанию для всех меток; у каждой дополнительной точки может быть своя иконка."

msgid "Default marker color"
msgstr "Цвет метки по умолчанию"

msgid "Applied to markers without their own color."
msgstr "Применяется к меткам без собственного цвета."

msgid "Additional markers"
msgstr "Дополнительные метки"

msgid "Base style"
msgstr "Базовый стиль"

msgid "Palette"
msgstr "Палитра"

msgid "Map language"
msgstr "Язык карты"

msgid "Language of feature labels and geocoder responses. “Auto” keeps the labels as they are in the tiles (usually the local language)."
msgstr "Язык подписей объектов и ответов геокодера. «Авто» оставляет подписи как в тайлах (обычно местный язык)."

msgid "Layer colors"
msgstr "Цвета слоёв"

msgid "Enable the layers you need and set their color and opacity. Applied on top of the base style and palette."
msgstr "Включите нужные слои и задайте их цвет и прозрачность. Применяется поверх базового стиля и палитры."

msgid "Hide POI (points of interest)"
msgstr "Скрыть POI (интересные места)"

msgid "Hide buildings (2D)"
msgstr "Скрыть здания (2D)"

msgid "Hide 3D buildings"
msgstr "Скрыть 3D-здания"

msgid "Hide terrain (raster layer)"
msgstr "Скрыть рельеф (растровый слой)"

msgid "Hide borders"
msgstr "Скрыть границы"

msgid "Hide rail and transit"
msgstr "Скрыть ж/д и транзит"

msgid "Hide all labels"
msgstr "Скрыть все подписи"

msgid "Terrain opacity, %"
msgstr "Прозрачность рельефа, %"

msgid "0 — terrain is invisible, 100 — fully visible."
msgstr "0 — рельеф не виден, 100 — виден полностью."

msgid "Search field background"
msgstr "Фон поля поиска"

msgid "Search field text"
msgstr "Текст поля поиска"

msgid "Search field border"
msgstr "Рамка поля поиска"

msgid "“Find” button — background"
msgstr "Кнопка «Найти» — фон"

msgid "“Find” button — text"
msgstr "Кнопка «Найти» — текст"

msgid "Search field corner radius, px"
msgstr "Скругление поля поиска, px"

msgid "0–24."
msgstr "0–24."

msgid "Show markers"
msgstr "Показывать метки"

msgid "Open the popup right away"
msgstr "Открывать подсказку сразу"

msgid "Zoom with the mouse wheel"
msgstr "Зум колесом мыши"

msgid "“Fullscreen” button"
msgstr "Кнопка «На весь экран»"

msgid "Search on the map"
msgstr "Поиск на карте"

msgid "Uses the OpenStreetMap Nominatim / Photon geocoder. Off by default for privacy."
msgstr "Использует геокодер OpenStreetMap Nominatim / Photon. По умолчанию выключен ради приватности."

msgid "Main address"
msgstr "Основной адрес"

msgid "Marker and popup"
msgstr "Метка и подсказка"

msgid "Size and zoom"
msgstr "Размер и масштаб"

msgid "Appearance"
msgstr "Внешний вид"

msgid "Map styling"
msgstr "Стилизация карты"

msgid "Layer visibility"
msgstr "Видимость слоёв"

msgid "Behaviour"
msgstr "Поведение"

msgid "Save"
msgstr "Сохранить"

msgid "Choose image"
msgstr "Выбрать изображение"

msgid "Remove"
msgstr "Удалить"

msgid "For example: Minsk, Nezavisimosti Ave 1"
msgstr "Например: Минск, пр-т Независимости 1"

msgid "Layer"
msgstr "Слой"

msgid "On"
msgstr "Вкл."

msgid "Color"
msgstr "Цвет"

msgid "Opacity, %"
msgstr "Прозрачность, %"

msgid "Opacity"
msgstr "Прозрачность"

msgid "Tick “On” for a layer to apply its color. Changing a color or opacity turns the layer on automatically. Changes take effect after you press “Save” at the bottom of the block."
msgstr "Отметьте «Вкл.» для слоя, чтобы применить его цвет. Изменение цвета или прозрачности включает слой автоматически. Изменения вступают в силу после нажатия «Сохранить» внизу блока."

msgid "+ Add marker"
msgstr "+ Добавить метку"

msgid "Latitude"
msgstr "Широта"

msgid "Longitude"
msgstr "Долгота"

msgid "Search by address…"
msgstr "Поиск по адресу…"

msgid "Address in the popup (HTML allowed)"
msgstr "Адрес в подсказке (можно HTML)"

msgid "Custom icon (optional)"
msgstr "Своя иконка (необязательно)"

msgid "Choose icon"
msgstr "Выбрать иконку"

msgid "Marker color"
msgstr "Цвет метки"

msgid "default"
msgstr "по умолчанию"

msgid "Delete"
msgstr "Удалить"

msgid "Settings imported."
msgstr "Настройки импортированы."

msgid "Could not import: invalid JSON."
msgstr "Не удалось импортировать: некорректный JSON."

msgid "Previous settings restored."
msgstr "Предыдущие настройки восстановлены."

msgid "A map on MapLibre GL JS and OpenStreetMap: no Google, no Yandex, no API keys and no ads."
msgstr "Карта на MapLibre GL JS и OpenStreetMap: без Google, без Яндекса, без API-ключей и рекламы."

msgid "Save changes"
msgstr "Сохранить изменения"

msgid "Preview"
msgstr "Предпросмотр"

msgid "Updates after you press “Save” in any block."
msgstr "Обновляется после нажатия «Сохранить» в любом блоке."

msgid "Copy shortcode with current settings"
msgstr "Скопировать шорткод с текущими настройками"

msgid "Restore the previous saved settings?"
msgstr "Восстановить предыдущие сохранённые настройки?"

msgid "Roll back the previous settings"
msgstr "Откатить предыдущие настройки"

msgid "Restore the markers from the last version that had them?"
msgstr "Восстановить метки из последней версии, где они были?"

msgid "Restore markers"
msgstr "Восстановить метки"

msgid "Import / export settings"
msgstr "Импорт / экспорт настроек"

msgid "Export is a JSON file with all settings that you can import on another site (address, markers, colors, styling)."
msgstr "Экспорт — это JSON-файл со всеми настройками, который можно импортировать на другом сайте (адрес, метки, цвета, стилизация)."

msgid "Download settings (JSON)"
msgstr "Скачать настройки (JSON)"

msgid "Import settings? The current settings will be overwritten (you can roll back)."
msgstr "Импортировать настройки? Текущие настройки будут перезаписаны (можно откатить)."

msgid "…or paste the JSON content here"
msgstr "…или вставьте содержимое JSON сюда"

msgid "Import"
msgstr "Импортировать"

msgid "How to place the map"
msgstr "Как разместить карту"

msgid "Shortcode — put it in a text/code block or any content area:"
msgstr "Шорткод — вставьте в блок «текст/код» или в любое место контента:"

msgid "Widget — “Appearance → Widgets”, the “Office Map” block."
msgstr "Виджет — «Внешний вид → Виджеты», блок «Office Map»."

msgid "Moving to another site: copy the wp-content/plugins/office-map/ folder and activate the plugin."
msgstr "Перенос на другой сайт: скопируйте папку wp-content/plugins/office-map/ и активируйте плагин."

msgid "An office map (MapLibre + OpenStreetMap) without Google or Yandex."
msgstr "Карта офиса (MapLibre + OpenStreetMap) без Google и Яндекса."

msgid "Title"
msgstr "Заголовок"

msgid "Palette (original/google/yandex)"
msgstr "Палитра (original/google/yandex)"

msgid "Empty fields use the values from the Office Map settings page."
msgstr "Пустые поля используют значения со страницы настроек Office Map."

